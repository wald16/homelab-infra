# ================================
# Nextcloud stack - Example env
# Usado por nextcloud/docker-compose.yml
# ================================

POSTGRES_HOST=changeme
POSTGRES_DB=changeme
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
NEXTCLOUD_ADMIN_USER=changeme
NEXTCLOUD_ADMIN_PASSWORD=changeme

# Además, el servicio "postgres" toma POSTGRES_PASSWORD desde este mismo archivo
# (usarlo también como .env en nextcloud/ para ese servicio).
